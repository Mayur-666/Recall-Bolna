# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recall

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_MIN=720
DEMO_EMAIL=demo@recall.local
DEMO_PASSWORD=replace-with-demo-password
DEMO_NAME=Mayur
APP_TIMEZONE=Asia/Kolkata

# --- Model (embeddings + extraction), any OpenAI-compatible endpoint ---
MODEL_BASE_URL=http://ollama:11434/v1
MODEL_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
# Must match the DB vector column; changing it needs a migration + re-embed (see README).
EMBED_DIM=768
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX="search_document: "
EMBED_TIMEOUT_S=1.5
EXTRACT_MODEL=qwen2.5:7b-instruct

# --- Retrieval (calibrated by eval/run_retrieval_eval.py) ---
RETRIEVAL_MIN_VECTOR_SIM=0.68
AMBIGUITY_MARGIN=0.15
LINK_MIN_SIM=0.75
RRF_K=60
MAX_RESULTS=5
EXCERPT_MAX_CHARS=400

# --- Ingestion limits ---
MAX_UPLOAD_BYTES=1000000
MAX_TRANSCRIPT_CHARS=200000

# --- Bolna ---
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=https://api.bolna.ai
# The @bolna/web-call 3.0.1 SDK documents this path; the docs page shows /web-call/session.
BOLNA_WEB_CALL_SESSION_PATH=/web-call/freeswitch-session
BOLNA_WEBHOOK_IP=13.203.39.153
# Spoken answers to typed questions use the local Kokoro-82M service (docker compose service "tts").
# The model is downloaded into the image at build time. Voices baked in: af_heart af_bella af_nicole
# af_sarah am_michael am_adam bf_emma bm_george (add more via the KOKORO_VOICES build arg).
KOKORO_VOICE=af_heart
# Alternative: the agent's own (Cartesia) voice. Used only if Kokoro isn't running. Bolna has no standalone TTS API,
# so this needs your own Cartesia key (https://play.cartesia.ai). Empty = the browser's voice is used.
CARTESIA_API_KEY=
# Optional overrides; empty = use the voice/model configured on the Bolna agent.
TTS_VOICE_ID=
TTS_MODEL=
# Dedicated secret Bolna sends to Recall's tool endpoints (Authorization: Bearer ...)
RECALL_TOOL_TOKEN=replace-with-a-long-random-string
# Public HTTPS URL of the backend. Leave empty with docker compose: the backend reads the tunnel's
# URL itself and updates the Bolna agent on every start. Set it only for a fixed domain.
PUBLIC_BASE_URL=
CALL_TOKEN_TTL_MIN=30
TOOL_RATE_LIMIT_PER_MIN=30
COOKIE_SECURE=false
